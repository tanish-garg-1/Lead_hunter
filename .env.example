# Copy this file to ".env" and fill in your keys.

# Google Places API (New) key. Leave empty to use the free OpenStreetMap fallback (weaker data).
GOOGLE_PLACES_API_KEY=

# Groq key (free, no card): https://console.groq.com/keys  — used for "help me decide" and owner-name extraction
GROQ_API_KEY=

# Where business data comes from: overture (free, best in tests), osm (free) or google (needs a key).
# DATA_SOURCE_BY_COUNTRY can override per country, e.g. portugal:osm — everything else uses DATA_SOURCE_DEFAULT.
DATA_SOURCE_DEFAULT=overture
DATA_SOURCE_BY_COUNTRY=

# Hard stop for Google requests per month. Google's free cap for this SKU is 1,000.
MONTHLY_REQUEST_LIMIT=900

# Optional: Groq model for the discussion
GROQ_MODEL=openai/gpt-oss-120b
